        {
          "name": "Event detail - GET /api/events/{idOrSlug}",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "{{eventSlug}}"
              ]
            },
            "description": "Accepts a numeric id or a slug. Draft and cancelled events answer 404 here; admins read them with Admin → *Event detail*. Saves `eventId`, which the order and gate requests use.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const e = pm.response.json();",
                  "if (e.id) { pm.environment.set(\"eventId\", e.id); console.log(\"eventId =\", e.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Seats for event - GET /api/events/{idOrSlug}/seats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventSlug}}/seats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "{{eventSlug}}",
                "seats"
              ]
            },
            "description": "Flat list of seats (status AVAILABLE | HELD | BOOKED | BLOCKED). With a token, your own holds come back with `mine: true`. Saves the first two AVAILABLE seat ids into `seatId1`/`seatId2`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const seats = pm.response.json();",
                  "const free = seats.filter(s => s.status === \"AVAILABLE\").slice(0, 2);",
                  "if (free[0]) pm.environment.set(\"seatId1\", free[0].id);",
                  "if (free[1]) pm.environment.set(\"seatId2\", free[1].id);",
                  "console.log(\"Saved seats:\", free.map(s => s.id + \" (\" + s.label + \")\").join(\", \") || \"none available\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 · Holds",
      "description": "Requires a token. Holds are all-or-nothing and expire after **5 minutes** (`app.hold.duration = PT5M`); an expired hold is swept back to AVAILABLE. Live seat updates fan out over STOMP at `/api/ws` (WebSocket - not exercisable from Postman's HTTP requests).",
      "item": [
        {
          "name": "Hold seats - POST /api/events/{idOrSlug}/holds",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventSlug}}/holds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "{{eventSlug}}",
                "holds"
              ]
            },
            "description": "Holds every seat in the list for the caller, or none of them: **409** (RFC-7807, naming the seats) if any is already held or booked. Holding seats you already hold extends the hold. Refused outside the event's sales window, beyond the per-person cap (8 seats per event, 422 `TOO_MANY_SEATS`) and over the rate limit (429). Run *Seats for event* first so `seatId1`/`seatId2` are set.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatIds\": [{{seatId1}}, {{seatId2}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "My holds - GET /api/events/{idOrSlug}/holds/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventSlug}}/holds/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "{{eventSlug}}",
                "holds",
                "me"
              ]
            },
            "description": "The caller's current holds for this event, with `heldUntil`."
          }
        },
        {
          "name": "Release my holds - DELETE /api/events/{idOrSlug}/holds",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventSlug}}/holds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "{{eventSlug}}",
                "holds"
              ]
            },
            "description": "Releases all of the caller's holds for this event. 409 `ORDER_PENDING` while an unpaid order of yours still covers them: cancel that order instead."
          }
        }
      ]
    },
    {
      "name": "04 · Orders",
      "description": "Requires a token. Flow: hold seats → **Create order** (turns your holds into a PENDING_PAYMENT order with a payment window) → **Pay**. Statuses: PENDING_PAYMENT | PAID | CANCELLED | EXPIRED.",
      "item": [
        {
          "name": "Create order - POST /api/orders",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Fresh GUID per attempt. Reusing the same key on a retry of the SAME order clashes with uq_payments_provider_ref - just send again to get a new one."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Creates an order from the caller's **held** seats (hold them first). Idempotent per `Idempotency-Key`. Saves `orderId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{eventId}},\n  \"seatIds\": [{{seatId1}}, {{seatId2}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Order created\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const o = pm.response.json();",
                  "if (o.id) { pm.environment.set(\"orderId\", o.id); console.log(\"orderId =\", o.id, \"number =\", o.orderNumber); }"
                ]
              }
            }
          ]
        },
        {
          "name": "My orders - GET /api/orders/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "me"
              ]
            }
          }
        },
        {
          "name": "Order detail - GET /api/orders/{id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "404 for another user's order."
          }
        },
        {
          "name": "Pay (mock card) - POST /api/orders/{id}/pay",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Fresh GUID per attempt. Reusing the same key on a retry of the SAME order clashes with uq_payments_provider_ref - just send again to get a new one."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}",
                "pay"
              ]
            },
            "description": "Pays via the configured gateway (`app.payment.provider`, default **mock**).\n\n**Mock cards:** `4242 4242 4242 4242` → success · `4000 0000 0000 0002` → declined · `4000 0000 0000 9995` → insufficient funds.\n\n**Stripe (server-confirm)** - set `APP_PAYMENT_PROVIDER=stripe` and send instead:\n\n```json\n{ \"paymentMethodId\": \"pm_card_visa\" }\n```\n\nClient-confirm (Stripe Elements) returns a `client_secret` and the webhook completes the order. If seats were lost while paying you get a SEATS_LOST compensation (auto-refund + cancel).\n\n**Answers.** A decline is 402 and carries the payment itself, with `failureCode` and `failureMessage`. `REQUIRES_ACTION` means 3-D Secure: its `clientSecret` goes to Stripe.js in the browser. Postman's `{{$guid}}` makes a new `Idempotency-Key` on every send, so each send is a new attempt; resend an attempt's own key to replay its answer instead of paying twice.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card\": {\n    \"number\": \"4242 4242 4242 4242\",\n    \"expMonth\": 12,\n    \"expYear\": 2030,\n    \"cvc\": \"123\",\n    \"holder\": \"Kalana Sandakelum\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Payment attempts - GET /api/orders/{id}/payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}",
                "payments"
              ]
            }
          }
        },
        {
          "name": "Cancel order - POST /api/orders/{id}/cancel",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}",
                "cancel"
              ]
            },
            "description": "Cancels a PENDING_PAYMENT order and releases its seats. A paid order can't be cancelled here."
          }
        }
      ]
    },
    {
      "name": "05 · Tickets",
      "description": "Tickets are issued when an order is PAID. PDFs (with the QR code) are pre-rendered asynchronously to MinIO/in-memory storage and regenerated on a miss.",
      "item": [
        {
          "name": "Tickets for order - GET /api/orders/{orderId}/tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}",
                "tickets"
              ]
            },
            "description": "Saves `ticketId` and `qrToken` (used by Gate → *Scan ticket*)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const tickets = pm.response.json();",
                  "if (tickets.length) {",
                  "    pm.environment.set(\"ticketId\", tickets[0].id);",
                  "    if (tickets[0].qrToken) pm.environment.set(\"qrToken\", tickets[0].qrToken);",
                  "    console.log(\"ticketId =\", tickets[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Ticket detail - GET /api/tickets/{id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "{{ticketId}}"
              ]
            },
            "description": "404 for a stranger's ticket."
          }
        },
        {
          "name": "Ticket PDF - GET /api/tickets/{id}/pdf",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "{{ticketId}}",
                "pdf"
              ]
            },
            "description": "`application/pdf` with the QR code. In Postman use **Send and Download** (arrow next to Send) to save the file."
          }
        }
      ]
    },
    {
      "name": "06 · Payments (public)",
      "item": [
        {
          "name": "Payment config - GET /api/payments/config",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "config"
              ]
            },
            "description": "The active provider and the Stripe publishable key, which the checkout reads to choose Stripe Elements or the mock card form; `testMode` (no real money can be taken) and `demo` (the demo season is seeded), which decide whether the storefront calls itself a demonstration and says checkout runs in test mode.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Stripe webhook - POST /api/payments/stripe/webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Stripe-Signature",
                "value": "t=1700000000,v1=replace-with-real-signature",
                "description": "Generated by Stripe; cannot be handcrafted."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/stripe/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "stripe",
                "webhook"
              ]
            },
            "description": "Signature-verified and idempotent (`payment_webhook_events`), so this sample body will be **rejected (400)** without a real `Stripe-Signature`.\n\nTo exercise it for real:\n\n```\nstripe listen --forward-to localhost:8081/api/payments/stripe/webhook\nstripe trigger payment_intent.succeeded\n```\n\nand put the printed whsec_… in `STRIPE_WEBHOOK_SECRET`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_local_example\",\n  \"object\": \"event\",\n  \"type\": \"payment_intent.succeeded\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"pi_local_example\",\n      \"object\": \"payment_intent\",\n      \"status\": \"succeeded\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "07 · Admin (ADMIN role)",
      "description": "Needs the `admin` realm role: grant it with `scripts/grant-role.sh admin <user>`, then get a new token.",
      "item": [
        {
          "name": "All events - GET /api/admin/events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/events?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "events"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "draft",
                  "disabled": true
                },
                {
                  "key": "sport",
                  "value": "cricket",
                  "disabled": true
                },
                {
                  "key": "series",
                  "value": "icc-t20-2026",
                  "disabled": true
                }
              ]
            },
            "description": "Every event, drafts and cancelled ones included, which the public list leaves out. Filter with the disabled params."
          }
        },
        {
          "name": "Create event - POST /api/admin/events",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "events"
              ]
            },
            "description": "Required: name, slug, sport, venue, startsAt, currency. Optional: seriesId, homeTeamId/awayTeamId (existing ids: Admin → *Teams* lists them). Saves `adminEventId`. Also saves `adminEventSlug`. The pre-request script dates the event a month out, on sale from the day before until two hours before kickoff, and the slug takes a timestamp, so the request can be sent again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sri Lanka v Afghanistan\",\n  \"slug\": \"sri-lanka-afghanistan-{{$timestamp}}\",\n  \"sport\": \"CRICKET\",\n  \"venue\": \"R. Premadasa Stadium\",\n  \"city\": \"Colombo\",\n  \"country\": \"Sri Lanka\",\n  \"stage\": \"Group Stage\",\n  \"startsAt\": \"{{eventStartsAt}}\",\n  \"salesStartAt\": \"{{salesStartAt}}\",\n  \"salesEndAt\": \"{{salesEndAt}}\",\n  \"timeZone\": \"Asia/Colombo\",\n  \"currency\": \"LKR\",\n  \"status\": \"draft\",\n  \"seriesId\": 1,\n  \"blurb\": \"A Colombo night under lights as the hosts open their campaign.\",\n  \"image\": \"1540747913346-19e32dc3e97e\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// a month out, on sale from yesterday until two hours before kickoff, so the event can be sold",
                  "const day = 24 * 60 * 60 * 1000;",
                  "const startsAt = new Date(Date.now() + 30 * day);",
                  "pm.environment.set(\"eventStartsAt\", startsAt.toISOString());",
                  "pm.environment.set(\"salesStartAt\", new Date(Date.now() - day).toISOString());",
                  "pm.environment.set(\"salesEndAt\", new Date(startsAt.getTime() - 2 * 60 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created\", () => pm.response.to.have.status(201));",
                  "const e = pm.response.json();",
                  "if (e.id) { pm.environment.set(\"adminEventId\", e.id); console.log(\"adminEventId =\", e.id); }",
                  "if (e.slug) pm.environment.set(\"adminEventSlug\", e.slug);"
                ]
              }
            }
          ]
        },
