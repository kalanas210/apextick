# OS / logs
.DS_Store
Thumbs.db
*.log

# Local-only artefacts (never commit)
output/
tmp/
load-test/results/

# NOTE: the PolinRider malware (2026-06) appended its own artifact names here
# (branch_structure.json, temp_auto_push.bat, temp_interactive_push.bat) to hide them.
# They are intentionally NOT ignored so that their reappearance shows up in `git status`.
