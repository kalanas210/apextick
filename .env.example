# Copied as-is, this runs the local stack (`docker compose up`).
#
# Production (docker-compose.prod.yml) has no fallbacks for credentials and
# refuses to start until every one of these is set:
#   POSTGRES_USER  POSTGRES_PASSWORD  RABBITMQ_USER  RABBITMQ_PASSWORD
#   KEYCLOAK_ADMIN  KEYCLOAK_ADMIN_PASSWORD  S3_ACCESS_KEY  S3_SECRET_KEY
#   WSO2_ADMIN_PASSWORD  GRAFANA_PASSWORD
# plus SERVER_IP. Replace each changeme / minioadmin / admin value below with
# a generated secret there (e.g. `openssl rand -hex 24`) -- the check only
# catches a missing value, not a weak one.

POSTGRES_DB=apextick
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

RABBITMQ_USER=apextick
RABBITMQ_PASSWORD=changeme

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

SERVER_IP=YOUR_IP

# Images the prod stack pulls (docker-compose.prod.yml); defaults are the
# :latest tags CI publishes to GHCR. Pin a sha-<commit> tag to roll back.
# BOOKING_IMAGE=ghcr.io/kalanas210/apextick-booking:latest
# NOTIFICATION_IMAGE=ghcr.io/kalanas210/apextick-notification:latest
# FRONTEND_IMAGE=ghcr.io/kalanas210/apextick-frontend:latest

# Local dev only (docker-compose.yml): the issuer the API expects in tokens and
# the site URL used in e-mail links. Override them to exercise the stack through
# another hostname, e.g. the WSO2 gateway (see docs/wso2.md).
# JWT_ISSUER_URI=http://localhost:8180/realms/apextick
# APP_WEB_URL=http://localhost:3000

# Payments: mock (default, offline) | stripe
APP_PAYMENT_PROVIDER=mock

# Stripe test-mode keys (only needed when APP_PAYMENT_PROVIDER=stripe).
# secret + publishable from https://dashboard.stripe.com/test/apikeys
# webhook secret from the CLI (`stripe listen`) or a dashboard webhook endpoint.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
# Optional currency allow-list; empty accepts every currency Stripe supports.
STRIPE_SUPPORTED_CURRENCIES=

# Grafana (observability profile only): docker compose --profile observability up
# Production still needs GRAFANA_PASSWORD with the profile off, because compose
# resolves variables for the whole file. Grafana only applies it when its data
# volume is first created; change it later with `grafana cli admin reset-admin-password`.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Ticket PDF storage. Compose points these at the bundled MinIO; set S3_ENABLED=false
# to keep PDFs in memory, or clear S3_ENDPOINT and use real AWS credentials for S3.
S3_ENABLED=true
S3_ENDPOINT=http://minio:9000
S3_BUCKET=apextick-tickets
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# WSO2 API Manager: the default API gateway in production (docker-compose.prod.yml);
# opt-in locally via `docker compose --profile wso2 up`. Needs ~4 GB of free memory
# in dev, ~3 GB in prod; see docs/wso2.md.
WSO2_ADMIN_PASSWORD=changeme
WSO2_JVM_MEM_OPTS=-Xms1g -Xmx2g
# Container memory cap. Left unset, each compose file uses its own default
# (4g in dev, 3g in prod); setting it here applies to both.
# WSO2_MEM_LIMIT=4g
# Bypass the gateway and point Caddy straight at booking-service (prod only --
# local dev's docker-compose.yml already defaults there when the wso2 profile
# is off):
# API_UPSTREAM=booking-service:8081

# Outgoing mail for Keycloak (account verification, password reset).
# Left as-is, everything goes to the bundled Mailpit at http://localhost:8025.
#
# To send real mail through Gmail:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an App Password (Google Account -> Security -> App passwords).
#      A normal account password will NOT work.
#   3. Fill these in — SMTP_FROM must be that same Gmail address, since Gmail
#      only lets you send as yourself or a verified alias.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=you@gmail.com
# SMTP_FROM_NAME=ApexTick

# Order e-mails are sent by notification-service, from this address. In
# production it follows SMTP_HOST/SMTP_PORT too, but it can't log in or use
# STARTTLS yet, so a provider like Gmail only carries Keycloak's mail.
# MAIL_FROM=no-reply@apextick.local

