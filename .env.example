POSTGRES_DB=apextick
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

RABBITMQ_USER=apextick
RABBITMQ_PASSWORD=changeme

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

SERVER_IP=YOUR_IP

# Payments: mock (default, offline) | stripe
APP_PAYMENT_PROVIDER=mock

# Stripe test-mode keys (only needed when APP_PAYMENT_PROVIDER=stripe).
# secret + publishable from https://dashboard.stripe.com/test/apikeys
# webhook secret from the CLI (`stripe listen`) or a dashboard webhook endpoint.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
# Optional currency allow-list; empty accepts every currency Stripe supports.
STRIPE_SUPPORTED_CURRENCIES=

# Grafana (observability profile only): docker compose --profile observability up
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Ticket PDF storage. Compose points these at the bundled MinIO; set S3_ENABLED=false
# to keep PDFs in memory, or clear S3_ENDPOINT and use real AWS credentials for S3.
S3_ENABLED=true
S3_ENDPOINT=http://minio:9000
S3_BUCKET=apextick-tickets
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
