# Single public HTTPS origin for the whole app. Caddy terminates TLS with an
# automatically-provisioned, browser-trusted ACME certificate and routes by
# path to the internal services over the docker network.
#
# SERVER_IP is injected from the environment (docker-compose), e.g.
# 13.212.113.135  ->  https://13.212.113.135.nip.io
{$SERVER_IP}.nip.io {
	encode gzip

	# --- Keycloak: only what the apextick realm's OIDC flow needs ---
	#   /realms     discovery, auth, token, login pages, account console
	#   /resources  theme CSS/JS/images for those pages
	#   /js         keycloak.js, for adapters that load it from the server
	# `handle` (not handle_path) keeps the full path so Keycloak sees /realms/...
	#
	# Keycloak's admin console and admin REST API (/admin/...) are deliberately
	# not published: /admin belongs to the Next.js admin panel, which falls
	# through to the frontend below. The master realm, whose only users are
	# Keycloak administrators, is closed too, so nobody on the internet can use
	# its token endpoint to guess the bootstrap admin password. Operators reach
	# the console over an SSH tunnel to Keycloak's loopback-only port instead --
	# see the keycloak service in docker-compose.prod.yml.
	handle /realms/master {
		respond 404
	}
	handle /realms/master/* {
		respond 404
	}
	handle /realms/* {
		reverse_proxy keycloak:8080
	}
	handle /resources/* {
		reverse_proxy keycloak:8080
	}
	handle /js/* {
		reverse_proxy keycloak:8080
	}

	# --- Booking API ---
	# The STOMP handshake stays on a direct route: it is a long-lived upgraded
	# connection, not a request the API gateway has anything useful to say about.
	handle /api/ws* {
		reverse_proxy booking-service:8081
	}

	# Everything else can go through WSO2 when the wso2 profile is up — set
	# API_UPSTREAM=wso2am:8280 — and falls back to the service directly.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:booking-service:8081}
	}

	# --- Everything else -> Next.js frontend (/, /admin, /_next, ...) ---
	handle {
		reverse_proxy frontend:3000
	}
}
